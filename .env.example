# Copy this file to .env and change the secrets before starting.
# cp .env.example .env

# Postgres credentials (used by the db container and the backend)
POSTGRES_USER=gateway
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=gateway

# Single shared admin token for the admin panel and admin APIs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-please

# Origins allowed to call the backend API directly (browser CORS).
CORS_ORIGINS=["http://localhost:3000"]
